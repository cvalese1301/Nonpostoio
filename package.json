{
  "name": "nonposto-io",
  "version": "1.0.0",
  "description": "Social media management platform inspired by Publer.io with multi-channel scheduling, pCloud storage, and MCP AI integration",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "mcp": "node bin/mcp-server.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "NonPosto.io Team",
  "license": "MIT"
}
